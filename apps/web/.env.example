# Copy to .env.local and fill in. This file is committed: placeholders only, never
# real keys.

# Supabase API (Project Settings > API). The secret key bypasses RLS: server only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Postgres for Drizzle (Project Settings > Database > Connection string).
# App: transaction pooler (port 6543). Migrations: session/direct connection (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Session cookie signing key: 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# SEP-10 challenge signing key (S...). Needs no funds; NOT the escrow admin key.
#   node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
SEP10_SIGNING_SECRET=

WEB_AUTH_DOMAIN=localhost:3000
HOME_DOMAIN=localhost:3000
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Stellar contracts: copy the ids from deploy/testnet.json.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
ESCROW_CONTRACT_ID=
PASS_CONTRACT_ID=
STAMPS_CONTRACT_ID=
USDC_CONTRACT_ID=
EURC_CONTRACT_ID=
XLM_CONTRACT_ID=
# Server keys (S...). Escrow admin: `stellar keys show estela-admin`.
# Backend (stamps issuer / pass awarder): `stellar keys show estela-backend`.
ESCROW_ADMIN_SECRET=
BACKEND_SECRET=

# Duffel (app.duffel.com > Developers > Access tokens). Test tokens start with duffel_test_.
DUFFEL_TOKEN=
# Estela's service fee per flight passenger, in the offer's currency.
FLIGHT_SERVICE_FEE=10
# Testnet demo only: XLM charged per EUR/USD for packages paid in XLM.
DEMO_XLM_PER_FIAT=1

# Pollar (dashboard.pollar.xyz > Build > API Keys)
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
